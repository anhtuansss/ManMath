generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  fullName     String?
  avatarUrl    String?
  googleId     String?      @unique
  passwordHash String?
  authProvider AuthProvider @default(google)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  attempts     Attempt[]
}

model Topic {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  subtopics   Subtopic[]
}

model Subtopic {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  topicId   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  topic     Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, name])
  @@index([topicId])
}

model Exam {
  id              String             @id
  title           String
  description     String
  durationMinutes Int
  subject         String
  difficulty      ExamDifficulty
  year            Int?
  statusLabel     String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  source          String?
  attempts        Attempt[]
  versions        ExamVersion[]
}

model Attempt {
  id                        String                @id @default(cuid())
  examId                    String
  userId                    String?
  score                     Float
  correctCount              Int
  totalQuestions            Int
  unansweredCount           Int
  startedAt                 DateTime?
  submittedAt               DateTime              @default(now())
  durationSeconds           Int?
  maxScoreUnits             Int?
  scoreUnits                Int?
  scoringPolicy             AttemptScoringPolicy?
  contentSnapshotVersion    Int?
  examContentSnapshot       Json?
  examVersionId             String?
  anonymousReceiptTokenHash String?
  anonymousReceiptExpiresAt DateTime?
  exam                      Exam                  @relation(fields: [examId], references: [id])
  examVersion               ExamVersion?          @relation(fields: [examVersionId], references: [id], onDelete: Restrict)
  user                      User?                 @relation(fields: [userId], references: [id])
  answers                   AttemptAnswer[]

  @@index([examId])
  @@index([examVersionId])
  @@index([userId])
  @@index([submittedAt])
  @@index([anonymousReceiptExpiresAt])
}

model ExamVersion {
  id              String                @id @default(cuid())
  examId          String
  versionNumber   Int
  status          ExamVersionStatus     @default(draft)
  publishProfile  ExamPublishProfile    @default(practice)
  title           String
  description     String
  durationMinutes Int
  subject         String
  difficulty      ExamDifficulty
  source          String?
  year            Int?
  statusLabel     String
  scoringPolicy   AttemptScoringPolicy  @default(vietnam_thpt_math_2025)
  contentChecksum String
  publishedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  attempts        Attempt[]
  exam            Exam                  @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions       ExamVersionQuestion[]

  @@unique([examId, versionNumber])
  @@index([examId, status])
}

model ExamVersionQuestion {
  id            String       @id @default(cuid())
  examVersionId String
  externalId    String
  order         Int
  type          QuestionType
  section       Int
  content       String
  topicSlug     String
  topicName     String
  subtopicSlug  String?
  subtopicName  String?
  assets        Json?
  choices       Json?
  statements    Json?
  answerKey     Json
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  examVersion    ExamVersion     @relation(fields: [examVersionId], references: [id], onDelete: Cascade)
  attemptAnswers AttemptAnswer[]

  @@unique([examVersionId, externalId])
  @@unique([examVersionId, order])
  @@index([examVersionId, type])
  @@index([topicSlug])
  @@index([subtopicSlug])
}

model AttemptAnswer {
  id                    String               @id @default(cuid())
  attemptId             String
  isCorrect             Boolean
  awardedScoreUnits     Int?
  isFullyCorrect        Boolean?
  maxScoreUnits         Int?
  questionExternalId    String?
  examVersionQuestionId String
  questionType          QuestionType?
  response              Json?
  attempt               Attempt              @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examVersionQuestion   ExamVersionQuestion  @relation(fields: [examVersionQuestionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, examVersionQuestionId])
  @@index([attemptId])
  @@index([examVersionQuestionId])
}

enum ExamDifficulty {
  easy
  medium
  hard
}

enum QuestionType {
  single_choice
  true_false_group
  short_answer
}

enum AttemptScoringPolicy {
  vietnam_thpt_math_2025
}

enum ExamVersionStatus {
  draft
  published
  archived
}

enum ExamPublishProfile {
  official_full_exam
  practice
}

enum AuthProvider {
  google
  password
}
